FROM ubuntu:24.04
LABEL org.opencontainers.image.authors="senthil@uthcode.com"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -qyy \
    -o APT::Install-Recommends=false -o APT::Install-Suggests=false \
    build-essential \
    libncurses-dev \
    libreadline-dev \
    libssl-dev \
    libgdbm-dev \
    libc6-dev \
    libsqlite3-dev \
    tk-dev \
    libbz2-dev \
    liblzma-dev \
    libffi-dev \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python3-virtualenv \
    libmysqlclient-dev \
    openssl \
    ssh \
    git \
    vim \
    emacs \
    ca-certificates \
    unzip \
    docker.io \
    mysql-server \
    && rm -rf /var/lib/apt/lists/*

# Services do not survive past the build step, so start MySQL when the
# container runs, e.g.: docker run -it ubuntu-base bash -c "service mysql start && bash"
CMD ["/bin/bash"]
